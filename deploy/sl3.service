[Unit]
Description=SingLink 3.0 node
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/sl3 server -c /etc/sl3/server.json
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/sl3
Restart=on-failure
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
