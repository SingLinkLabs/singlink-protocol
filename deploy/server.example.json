{
  "listen": ":443",
  "private_key": "<private_key from: singlink keygen server>",
  "issuers": ["<public_key from: singlink keygen issuer>"],
  "tls_cert": "/etc/singlink/fullchain.pem",
  "tls_key": "/etc/singlink/privkey.pem",
  "fallback": "127.0.0.1:8080",
  "allow_private": false,
  "blocked_ports": [25],
  "revoked_file": "/etc/singlink/revoked.txt",
  "log_level": "info"
}
